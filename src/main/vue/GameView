package vue;

import javafx.scene.Scene;
import javafx.scene.canvas.Canvas;
import javafx.scene.canvas.GraphicsContext;
import javafx.scene.input.KeyEvent;
import javafx.scene.layout.StackPane;
import javafx.scene.paint.Color;
import javafx.stage.Stage;

import model.Element;
import model.Grille;
import model.Jeu;
import model.Ligne;

public class GameView {

    private final Stage stage;
    private final Jeu jeu;
    private final Canvas canvas;
    private final Scene scene;

    public GameView(Stage stage, Jeu jeu) {
        this.stage = stage;
        this.jeu = jeu;

        this.canvas = new Canvas(900, 600);
        StackPane root = new StackPane(canvas);
        this.scene = new Scene(root);

        applyStyle();
        setupControls();

        AudioManager.playGameMusic();
        jeu.demarrer();
        draw();
    }

    private void applyStyle() {
        scene.getStylesheets().add(
                getClass().getResource("/ressources/style.css").toExternalForm()
        );
    }

    private void setupControls() {
        scene.setOnKeyPressed((KeyEvent e) -> {
            switch (e.getCode()) {
                case UP -> jeu.deplacerJoueurHaut();
                case DOWN -> jeu.deplacerJoueurBas();
                case LEFT -> jeu.deplacerJoueurGauche();
                case RIGHT -> jeu.deplacerJoueurDroite();
                case ESCAPE -> {
                    AudioManager.stop();
                    ViewManager.showMenu(stage);
                }
            }

            jeu.miseAJour();
            draw();
            checkGameState();
        });
    }

    // ---------------------------------------------------------
    //                🎨 DESSIN COMPLET DU JEU
    // ---------------------------------------------------------
    private void draw() {
        GraphicsContext gc = canvas.getGraphicsContext2D();
        int taille = 30;

        // Fond noir
        gc.setFill(Color.BLACK);
        gc.fillRect(0, 0, Grille.LARGEUR * taille, Grille.HAUTEUR * taille);

        // Dessiner chaque ligne
        for (int y = 0; y < jeu.getGrille().getLignes().size(); y++) {

            Ligne ligne = jeu.getGrille().getLignes().get(y);

            // Couleur selon le type
            switch (ligne.getType()) {
                case HERBE -> gc.setFill(Color.GREEN);
                case ROUTE -> gc.setFill(Color.DARKGRAY);
                case ARRIVEE -> gc.setFill(Color.GOLD);
                case DEPART -> gc.setFill(Color.BLUE);
            }

            // Fond de la ligne
            gc.fillRect(0, y * taille, Grille.LARGEUR * taille, taille);

            // Dessiner les éléments
            gc.setFill(Color.RED);
            for (Element e : ligne.getElements()) {
                gc.fillRect(e.getX() * taille, y * taille, taille, taille);
            }
        }

        // Dessiner le joueur
        gc.setFill(Color.WHITE);
        gc.fillOval(
                jeu.getJoueur().getX() * taille,
                jeu.getJoueur().getY() * taille,
                taille,
                taille
        );
    }

    // ---------------------------------------------------------
    //                🏆 VICTOIRE / 💀 DÉFAITE
    // ---------------------------------------------------------
private void checkGameState() {

    if (jeu.isWin()) {
        AudioManager.playWinMusic();
        ViewManager.showGameOverView(stage, true, jeu.getScore().getScoreActuel());
    }

    if (jeu.isLose()) {
        AudioManager.playLoseMusic();
        ViewManager.showGameOverView(stage, false, jeu.getScore().getScoreActuel());
    }
}


    public Scene getScene() {
        return scene;
    }
}

